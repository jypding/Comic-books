/**
 * VoiceBook V1 像素级渲染器 - PASS2 可视化排版版
 * 基准：1920 × 1080 逻辑画布，左上角原点，单位：像素
 * 特性：复用原有Three.js 3D引擎、按sceneArea像素定位场景、文字层绝对定位、整体统一缩放
 */
(function () {
  'use strict';

  const CANVAS_BASE_W = 1920;
  const CANVAS_BASE_H = 1080;
  const STAGE_ID = 'vb-fullstage';
  const CANVAS_ID = 'vb-v1-canvas';
  const MODE_CLASS = 'vb-v1-mode';

  let _canvasOriginalParent = null;
  let _canvasOriginalNextSibling = null;

  function injectStyles() {
    if (document.getElementById('vb-v1-style')) return;

    const css = `
      #${STAGE_ID} {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100vw;
        height: 100vh;
        z-index: 50;
        pointer-events: none;
        display: none;
      }

      body.${MODE_CLASS} #text-panel {
        display: none !important;
      }

      body.${MODE_CLASS} #canvas-container {
        position: absolute !important;
        margin: 0 !important;
        padding: 0 !important;
        flex: none !important;
        overflow: hidden !important;
        transform: none !important;
      }

      body.${MODE_CLASS} #${STAGE_ID} {
        display: block;
        pointer-events: auto;
      }

      #${CANVAS_ID} {
        position: absolute;
        left: 0;
        top: 0;
        width: ${CANVAS_BASE_W}px;
        height: ${CANVAS_BASE_H}px;
        transform-origin: top left;
        overflow: hidden;
      }

      .vb-v1-text-block {
        position: absolute;
        box-sizing: border-box;
        padding: 0;
        margin: 0;
        word-wrap: break-word;
        overflow: hidden;
        user-select: none;
        pointer-events: auto;
        z-index: 2;
      }

      .vb-v1-audio-btn {
        position: absolute;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        pointer-events: auto;
        z-index: 3;
      }

      .vb-v1-debug-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0.5;
        pointer-events: none;
        object-fit: cover;
        z-index: 1;
      }
    `;

    const styleEl = document.createElement('style');
    styleEl.id = 'vb-v1-style';
    styleEl.textContent = css;
    document.head.appendChild(styleEl);
  }

  class VoiceBookV1Renderer {
    constructor() {
      this.currentPage = null;
      this.scale = 1;
      this.stage = null;
      this.canvas = null;

      injectStyles();
      this._mountStage();
      this._bindResize();
    }

    _mountStage() {
      if (document.getElementById(STAGE_ID)) {
        this.stage = document.getElementById(STAGE_ID);
        this.canvas = document.getElementById(CANVAS_ID);
        return;
      }

      this.stage = document.createElement('div');
      this.stage.id = STAGE_ID;

      this.canvas = document.createElement('div');
      this.canvas.id = CANVAS_ID;

      this.stage.appendChild(this.canvas);
      document.body.appendChild(this.stage);
    }

    _updateScale() {
      if (!this.canvas) return;

      const w = window.innerWidth;
      const h = window.innerHeight;
      const scaleX = w / CANVAS_BASE_W;
      const scaleY = h / CANVAS_BASE_H;
      this.scale = Math.min(scaleX, scaleY);

      this.canvas.style.transform = `scale(${this.scale})`;

      console.log('[VoiceBook V1] scale =', this.scale.toFixed(3), 'viewport =', w + 'x' + h);

      setTimeout(() => window.dispatchEvent(new Event('resize')), 0);
    }

    _bindResize() {
      window.addEventListener('resize', () => this._updateScale());
    }

    enable() {
      document.body.classList.add(MODE_CLASS);

      const canvasContainer = document.getElementById('canvas-container');
      if (canvasContainer && !_canvasOriginalParent) {
        _canvasOriginalParent = canvasContainer.parentNode;
        _canvasOriginalNextSibling = canvasContainer.nextSibling;
        this.canvas.insertBefore(canvasContainer, this.canvas.firstChild);
      }

      setTimeout(() => this._updateScale(), 0);
    }

    disable() {
      document.body.classList.remove(MODE_CLASS);

      const canvasContainer = document.getElementById('canvas-container');
      if (canvasContainer && _canvasOriginalParent) {
        _canvasOriginalParent.insertBefore(canvasContainer, _canvasOriginalNextSibling);
        _canvasOriginalParent = null;
        _canvasOriginalNextSibling = null;
        setTimeout(() => window.dispatchEvent(new Event('resize')), 0);
      }

      this.clear();
    }

    renderPage(pageData) {
      if (!pageData) return;
      this.enable();
      this.currentPage = pageData;
      this.clear();

      if (pageData.layout && pageData.layout.sceneArea) {
        this._layoutSceneArea(pageData.layout.sceneArea);
      }

      if (pageData.textBoxes) {
        this._renderTextBoxes(pageData.textBoxes);
      }

      if (pageData.audioButton) {
        this._renderAudioButton(pageData.audioButton);
      }

      // 渲染后立即刷新 scale
      this._updateScale();
    }

    _layoutSceneArea(sceneArea) {
      const canvasContainer = document.getElementById('canvas-container');
      if (!canvasContainer) return;

      canvasContainer.style.left = sceneArea.x + 'px';
      canvasContainer.style.top = sceneArea.y + 'px';
      canvasContainer.style.width = sceneArea.w + 'px';
      canvasContainer.style.height = sceneArea.h + 'px';
    }

    _renderTextBoxes(textBoxes) {
      Object.values(textBoxes).forEach(block => {
        if (!block) return;

        const el = document.createElement('div');
        el.className = 'vb-v1-text-block';
        if (block.id) el.dataset.blockId = block.id;

        el.style.left = block.x + 'px';
        el.style.top = block.y + 'px';
        el.style.width = block.w + 'px';
        el.style.height = block.h + 'px';

        if (block.fontSize) el.style.fontSize = block.fontSize + 'px';
        if (block.lineHeight) el.style.lineHeight = block.lineHeight + 'px';
        if (block.fontFamily) el.style.fontFamily = block.fontFamily;
        if (block.color) el.style.color = block.color;
        if (block.textAlign) el.style.textAlign = block.textAlign;

        el.textContent = block.text || '';
        this.canvas.appendChild(el);
      });
    }

    _renderAudioButton(btnConfig) {
      const btn = document.createElement('div');
      btn.className = 'vb-v1-audio-btn';

      btn.style.left = btnConfig.x + 'px';
      btn.style.top = btnConfig.y + 'px';
      btn.style.width = btnConfig.w + 'px';
      btn.style.height = btnConfig.h + 'px';

      btn.textContent = '🔊';
      btn.title = '播放音频';

      this.canvas.appendChild(btn);
    }

    setDebugBackground(imgUrl) {
      this.clearDebug();
      if (!imgUrl) return;

      const img = document.createElement('img');
      img.className = 'vb-v1-debug-bg';
      img.src = imgUrl;
      this.canvas.insertBefore(img, this.canvas.firstChild);
    }

    clearDebug() {
      const old = this.canvas.querySelector('.vb-v1-debug-bg');
      if (old) old.remove();
    }

    clear() {
      const children = Array.from(this.canvas.children);
      children.forEach(el => {
        if (el.id !== 'canvas-container') {
          el.remove();
        }
      });
    }

    destroy() {
      this.disable();
      if (this.stage && this.stage.parentNode) {
        this.stage.parentNode.removeChild(this.stage);
      }
    }
  }

  window.VoiceBookV1Renderer = VoiceBookV1Renderer;
})();
