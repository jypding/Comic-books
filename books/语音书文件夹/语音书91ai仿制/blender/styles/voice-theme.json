{
  "theme": {
    "light": {
      "paper": "#F3EDDF",
      "ink": "#1E1E24",
      "gray": "#55555E",
      "accent": "#C73E3A",
      "ink-rgb": "30, 30, 36"
    },
    "dark": {
      "paper": "#17171B",
      "ink": "#E9E3D5",
      "gray": "#9C978C",
      "accent": "#DD5B54",
      "ink-rgb": "233, 227, 213"
    },
    "font-serif": "Georgia, 'Times New Roman', serif",
    "font-sans": "Arial, sans-serif"
  },
  "layout": {
    "panel-padding": "20px 30px",
    "button-radius": "4px",
    "transition-speed": "0.3s"
  },
  "components": {
    "voicePlayer": {
      "bg": "rgba(var(--ink-rgb), 0.05)",
      "border": "1px solid rgba(var(--ink-rgb), 0.15)",
      "accent": "var(--accent)",
      "height": "100px"
    }
  },
  "features": {
    "enableCameraSync": true
  }
}
