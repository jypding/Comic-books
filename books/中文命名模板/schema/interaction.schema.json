{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Voice Book Interaction",
  "type": "object",
  "properties": {
    "target": { "type": "string" },
    "event": { "type": "string", "enum": ["click", "hover", "touch"] },
    "action": { "type": "string", "enum": ["animate", "sound", "state_change", "visual_effect"] },
    "params": {
      "type": "object",
      "properties": {
        "animation_name": { "type": "string" },
        "audio_file": { "type": "string" },
        "state_key": { "type": "string" },
        "state_value": { "type": "any" },
        "effect_type": { "type": "string" },
        "duration": { "type": "number" }
      }
    }
  },
  "required": ["target", "event", "action"]
}
