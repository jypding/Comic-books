{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Voice Book Manifest",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "narration": {
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "voice": { "type": "string" },
        "preset": { "type": "string" }
      }
    },
    "pages": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["id", "title", "pages"]
}
