# LFS for heavy assets not served by Pages
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# GLB / PNG / JPG: NO LFS (GitHub Pages serves them directly)
*.glb  -filter -diff -merge -text
*.png  -filter -diff -merge -text
*.jpg  -filter -diff -merge -text
*.jpeg -filter -diff -merge -text
*.webp -filter -diff -merge -text

# 3D book publish dirs: absolutely no LFS (defense in depth)
books/*/book/** -filter -diff -merge -text
